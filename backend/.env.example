APP_TIMEZONE=Asia/Karachi
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=./storage
MODEL_ROOT=./model_assets
# Optional absolute path; otherwise storage/attendance.sqlite3 is used.
# DATABASE_PATH=C:/path/to/attendance.sqlite3
COOKIE_SECURE=false
ENABLE_AI=false
FACE_MODEL=sface
FACE_THRESHOLD=0.60
FACE_MARGIN=0.08
# Absolute path to official RF-DETR Small weights after installing AI runtime.
DETECTOR_WEIGHTS=
# Leave false until local false-match, direction and spoofing risks are evaluated.
ALLOW_AUTOMATIC_ATTENDANCE=false

# Optional: exact webcam sources whose driver output is mirrored, e.g. 700.
# Applies to workspace previews, recognition and recordings; not browser capture.
FLIP_WEBCAM_SOURCES=
